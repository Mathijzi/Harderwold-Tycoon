{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/shared",
    "src/sim",
    "src/server",
    "tests",
    "scripts/*.ts",
    "src/web/projector",
    "src/web/editor"
  ]
}
