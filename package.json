{
  "name": "harderwold-tycoon",
  "version": "0.1.0-prototype",
  "private": true,
  "description": "Harderwold Tycoon - visuele en verkeersproef (fase 1-3): server-authoritative verkeer, slagbomen, check-in/check-out via API, 4K-projectie.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node start.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "stress": "node --import tsx scripts/stress.ts",
    "e2e": "node scripts/e2e.mjs http://localhost:8090 screenshots",
    "multiseed": "node --import tsx scripts/multiseed.ts 20 42 7 1234 99 2026 5 11 31 77 500 1 2 3 4 8 14",
    "shot": "node scripts/shot.mjs http://localhost:8090/ screenshots/projectie_4k.png 3840 2160 7000"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.0",
    "pixi.js": "^8.21.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "playwright": "^1.56.0"
  }
}
